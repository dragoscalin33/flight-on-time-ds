# ==================================================
#  PROJECT-SPECIFIC RULES (FLIGHT ON TIME)
# ==================================================

# --- data-science (v5.0 Research) ---

# Raw data (large files)
data-science/data/raw/*

# Heavy processed CSVs
data-science/data/processed/BrFlights*.csv

# Exceptions — files that MUST be tracked
!data-science/data/processed/weather_history_2015_2017.csv
!data-science/data/references/*.csv

# Models — only allow the final v4 model
*.joblib
!data-science/src/flight_classifier_v4.joblib

